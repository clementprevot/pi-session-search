{
	"name": "@clementprevot/pi-session-search",
	"version": "0.1.0",
	"description": "Pi extension that fuzzy-searches all past session transcripts and resumes the one you pick",
	"keywords": [
		"pi-package",
		"pi-extension",
		"session",
		"search",
		"transcript",
		"picker"
	],
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clementprevot/pi-session-search.git"
	},
	"packageManager": "yarn@4.9.2",
	"engines": {
		"node": ">=22.6"
	},
	"files": [
		"index.ts",
		"indexer.ts",
		"picker.ts",
		"results.ts",
		"search.ts",
		"store.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@types/node": "^24.0.0",
		"typebox": "*",
		"typescript": "^5.9.0"
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public"
	}
}
